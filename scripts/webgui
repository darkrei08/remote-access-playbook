#!/bin/bash
# webgui - Firefox remoto su display X virtuale, accessibile via noVNC.
# Uso: webgui start|stop|restart|status|url|open <url>|fit|zoom <f>|res <WxH>|reset|logs
set -u

export HOME=/root
# Firefox rispetta Default=1 in profiles.ini invece di creare un profilo
# nuovo per installazione.
export MOZ_LEGACY_PROFILES=1
export MOZ_ENABLE_WAYLAND=0

D=:99
DN=99
VP=5900
WP=6080
PNAME=remote
P=/root/.mozilla/firefox/$PNAME
INI=/root/.mozilla/firefox/profiles.ini
CONF=/etc/webgui.conf
DBUSENV=/run/webgui-dbus.env
LOG=/var/log/webgui.log

# Risoluzione e zoom sono in /etc/webgui.conf, modificabili con 'res' e 'zoom'
GEOM=1440x900
DPPX=1.0
[ -r "$CONF" ] && . "$CONF"

export DISPLAY=$D
FF=$(command -v firefox-esr || command -v firefox || true)

die() { echo "errore: $*" >&2; exit 1; }
[ -n "$FF" ] || die "firefox non trovato nel PATH"

save_conf() {
  printf 'GEOM=%s\nDPPX=%s\n' "$GEOM" "$DPPX" > "$CONF"
}

# --- DBus di sessione persistente ------------------------------------------
# Serve al remoting: 'firefox --new-tab' deve parlare con l'istanza gia attiva,
# altrimenti un secondo processo tenta di aprire lo stesso profilo e Firefox
# segnala il profilo come mancante o in uso.
dbus_up() {
  [ -s "$DBUSENV" ] && . "$DBUSENV"
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] || \
     ! dbus-send --session --dest=org.freedesktop.DBus --type=method_call \
         /org/freedesktop/DBus org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
    unset DBUS_SESSION_BUS_ADDRESS
    eval "$(dbus-launch --sh-syntax)"
    printf "export DBUS_SESSION_BUS_ADDRESS='%s'\nexport DBUS_SESSION_BUS_PID='%s'\n" \
      "$DBUS_SESSION_BUS_ADDRESS" "${DBUS_SESSION_BUS_PID:-}" > "$DBUSENV"
    chmod 600 "$DBUSENV"
  fi
  export DBUS_SESSION_BUS_ADDRESS
}

# --- Profilo Firefox --------------------------------------------------------
write_userjs() {
  cat > "$P/user.js" <<PREFS
// Generato da webgui: non modificare a mano, usa 'webgui zoom'
user_pref("layout.css.devPixelsPerPx", "$DPPX");
// Nessuna GPU nel container: rendering software
user_pref("gfx.webrender.all", false);
user_pref("layers.acceleration.disabled", true);
// Meno processi figli: risparmio RAM
user_pref("dom.ipc.processCount", 2);
// Niente telemetria ne studi
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("app.shield.optoutstudies.enabled", false);
// Niente pagine di prima esecuzione ne ripristino sessione
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.firstRunURL", "");
user_pref("browser.startup.homepage_override.mstone", "ignore");
// Su VNC conviene ridurre animazioni e smooth scroll
user_pref("general.smoothScroll", false);
user_pref("ui.prefersReducedMotion", 1);
user_pref("browser.cache.disk.capacity", 102400);
PREFS
}

profile_up() {
  mkdir -p /root/.mozilla/firefox "$P"
  if ! grep -qs "^Name=$PNAME\$" "$INI"; then
    "$FF" --no-remote -CreateProfile "$PNAME $P" >/dev/null 2>&1
  fi
  write_userjs
  # I lock restano se Firefox e' stato terminato con SIGKILL
  rm -f "$P/.parentlock" "$P/lock" 2>/dev/null
}

own() { # pid che corrispondono al pattern e vivono nel nostro network namespace
  local ns pid
  ns=$(readlink /proc/self/ns/net)
  for pid in $(pgrep -f "$1" 2>/dev/null); do
    [ "$(readlink "/proc/$pid/ns/net" 2>/dev/null)" = "$ns" ] && echo "$pid"
  done
}

ff_running() { [ -n "$(own "^$FF -P $PNAME")" ]; }

kill_own() { # termina solo i processi del pattern dentro il nostro netns
  local pid
  for pid in $(own "$1"); do kill "$pid" 2>/dev/null; done
}

# --- Adatta la finestra al display ------------------------------------------
fit() {
  local w h
  w=${GEOM%x*}; h=${GEOM#*x}
  command -v xdotool >/dev/null || { echo "xdotool non installato"; return 1; }
  local id
  id=$(xdotool search --onlyvisible --class 'Navigator' 2>/dev/null | head -1)
  [ -z "$id" ] && id=$(xdotool search --onlyvisible --class 'firefox' 2>/dev/null | head -1)
  [ -z "$id" ] && { echo "finestra Firefox non trovata"; return 1; }
  xdotool windowmove "$id" 0 0 windowsize "$id" "$w" "$h" 2>/dev/null
  xdotool windowactivate "$id" 2>/dev/null
  echo "finestra adattata a ${w}x${h}"
}

up() {
  if [ -z "$(own "^Xvfb $D")" ]; then
    rm -f /tmp/.X${DN}-lock /tmp/.X11-unix/X${DN} 2>/dev/null
    Xvfb $D -screen 0 "${GEOM}x24" -dpi 96 +extension RANDR -nolisten tcp >>"$LOG" 2>&1 &
    sleep 1
  fi
  [ -n "$(own "^openbox")" ] || { openbox >>"$LOG" 2>&1 & sleep 1; }
  command -v autocutsel >/dev/null && {
    [ -n "$(own "^autocutsel -fork")" ] || autocutsel -fork >>"$LOG" 2>&1
    [ -n "$(own "^autocutsel -selection PRIMARY")" ] || autocutsel -selection PRIMARY -fork >>"$LOG" 2>&1
  }
  dbus_up
  profile_up
  if ! ff_running; then
    "$FF" -P "$PNAME" about:blank >>"$LOG" 2>&1 &
    sleep 5
    fit >/dev/null 2>&1
  fi
  [ -n "$(own "^x11vnc")" ] || x11vnc -display $D -rfbport $VP -localhost \
    -rfbauth /root/.vnc/passwd -forever -shared -bg -quiet >>"$LOG" 2>&1
  # 127.0.0.1 esplicito: senza indirizzo websockify ascolta su 0.0.0.0 e il
  # gateway finisce sulla LAN, fuori dal percorso Tailscale Serve.
  [ -n "$(own "^/usr/bin/python3 .*websockify.*$WP")" ] || \
    websockify --web=/usr/share/novnc -D 127.0.0.1:$WP localhost:$VP >>"$LOG" 2>&1
  url
}

down() {
  kill_own "^/usr/bin/python3 .*websockify.*$WP"
  kill_own "^x11vnc"
  kill_own "^$FF -P $PNAME"
  kill_own "^$FF"
  kill_own "^autocutsel"
  kill_own "^openbox"
  kill_own "^Xvfb $D"
  sleep 1
  rm -f /tmp/.X${DN}-lock /tmp/.X11-unix/X${DN} "$P/.parentlock" "$P/lock" 2>/dev/null
  echo "fermato"
}

url() {
  local s
  s=$(tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty' 2>/dev/null)
  if [ -n "$s" ]; then
    echo "https://$(hostname).${s}/vnc.html?resize=scale"
  else
    echo "http://$(hostname -I | awk '{print $1}'):${WP}/vnc.html?resize=scale"
  fi
}

st() {
  # Pattern ancorati a ^: senza ancoraggio pgrep -f trova anche la shell che ha
  # lanciato il comando, e il check direbbe ok per se stesso.
  for p in "Xvfb $D|^Xvfb $D" "openbox|^openbox" "firefox -P $PNAME|^$FF -P $PNAME" "x11vnc|^x11vnc" "websockify $WP|^/usr/bin/python3 .*websockify.*$WP"; do
    if [ -n "$(own "${p#*|}")" ]; then echo "ok    ${p%%|*}"; else echo "GIU   ${p%%|*}"; fi
  done
  ss -tlnH "( sport = :$VP or sport = :$WP )" 2>/dev/null | awk '{print "port  "$4}'
  # Un processo vivo non e' un listener: un websockify in un altro namespace
  # (container) soddisfa pgrep ma non ascolta qui.
  if [ -n "$(ss -tlnH "sport = :$WP" 2>/dev/null)" ]; then
    echo "gate  in ascolto su $WP"
  else
    echo "GATE  NESSUN LISTENER su $WP -> websockify non avviato"
  fi
  echo "geom  $GEOM  zoom $DPPX"
  [ -s "$DBUSENV" ] && echo "dbus  presente"
  if grep -qs "^Name=$PNAME\$" "$INI"; then echo "prof  $PNAME registrato"; else echo "PROF  $PNAME MANCANTE"; fi
  if tailscale serve status 2>/dev/null | grep -q "$WP"; then
    echo "serve attivo su $WP"
  else
    echo "SERVE NON ATTIVO -> tailscale serve --bg $WP"
  fi
}

open_url() {
  local u="${1:?serve un URL}"
  up >/dev/null
  if ff_running; then
    # Remoting: nuova scheda nell'istanza esistente, nessun secondo processo
    if "$FF" -P "$PNAME" --new-tab "$u" >>"$LOG" 2>&1; then
      echo "aperto (nuova scheda): $u"
      return 0
    fi
    echo "remoting fallito, riavvio Firefox sull'URL" >&2
    kill_own "^$FF"
    sleep 2
    rm -f "$P/.parentlock" "$P/lock" 2>/dev/null
  fi
  "$FF" -P "$PNAME" "$u" >>"$LOG" 2>&1 &
  sleep 5
  fit >/dev/null 2>&1
  echo "aperto (nuova istanza): $u"
}

set_zoom() {
  local z="${1:?esempio: webgui zoom 1.25}"
  case "$z" in
    ''|*[!0-9.]*) die "zoom non valido: $z" ;;
  esac
  DPPX="$z"
  save_conf
  profile_up
  echo "zoom impostato a $DPPX, riavvio Firefox"
  kill_own "^$FF"
  sleep 2
  rm -f "$P/.parentlock" "$P/lock" 2>/dev/null
  "$FF" -P "$PNAME" about:blank >>"$LOG" 2>&1 &
  sleep 5
  fit
}

set_res() {
  local g="${1:?esempio: webgui res 1920x1080}"
  case "$g" in
    [0-9]*x[0-9]*) : ;;
    *) die "formato non valido: usa LARGHEZZAxALTEZZA" ;;
  esac
  GEOM="$g"
  save_conf
  echo "risoluzione impostata a $GEOM, riavvio lo stack"
  down >/dev/null
  up
}

reset_all() {
  down
  rm -rf "$P" "$INI" "$DBUSENV"
  pkill -x dbus-daemon 2>/dev/null
  echo "profilo e dbus azzerati"
}

case "${1:-}" in
  start)   up ;;
  stop)    down ;;
  restart) down; up ;;
  status)  st ;;
  url)     url ;;
  open)    open_url "${2:-}" ;;
  fit)     fit ;;
  zoom)    set_zoom "${2:-}" ;;
  res)     set_res "${2:-}" ;;
  reset)   reset_all ;;
  logs)    tail -n 60 "$LOG" 2>/dev/null || echo "nessun log" ;;
  *)       echo "uso: webgui start|stop|restart|status|url|open <url>|fit|zoom <f>|res <WxH>|reset|logs" ;;
esac
